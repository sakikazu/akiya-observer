<% content_for :head do %>
  <link rel="stylesheet" href="https://unpkg.com/leaflet@1.9.4/dist/leaflet.css" integrity="sha256-p4NxAoJBhIIN+hmNHrzRCf9tD/miZyoHS5obTRR9BMY=" crossorigin="">
  <script src="https://unpkg.com/leaflet@1.9.4/dist/leaflet.js" integrity="sha256-20nQCchB9co0qIjJZRGuk2/Z9VM+kNiyxNV1lvTlZBo=" crossorigin=""></script>
  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
  <link href="https://fonts.googleapis.com/css2?family=Space+Grotesk:wght@500;700&family=Noto+Sans+JP:wght@400;600&display=swap" rel="stylesheet">
<% end %>

<div class="map-shell" data-controller="map" data-map-listings-value="<%= json_escape(@map_listings.to_json) %>">
  <aside class="map-sidebar">
    <div class="map-hero">
      <p class="map-eyebrow">Akiya Observer</p>
      <h1>新着物件の分布を<br>地図で俯瞰する</h1>
      <p class="map-subtitle">
        住所精度と更新日を合わせて確認し、供給の偏りを一目で把握します。
      </p>
      <div class="map-controls">
        <label class="toggle">
          <input type="checkbox" data-action="map#toggleDisappeared">
          <span>掲載終了も表示</span>
        </label>
        <div class="legend">
          <span class="legend-item"><span class="dot dot-precise"></span>番地あり</span>
          <span class="legend-item"><span class="dot dot-area"></span>番地なし</span>
          <span class="legend-item"><span class="dot dot-gone"></span>掲載終了</span>
        </div>
      </div>
    </div>

    <section class="map-panel">
      <h2>ジオコーディング待ち</h2>
      <p class="map-muted">座標未取得: <strong><%= @missing_count %></strong> 件</p>
      <div class="pending-list">
        <% @missing_geocodes.each do |listing| %>
          <div class="pending-card">
            <p class="pending-title"><%= listing.title %></p>
            <p class="pending-meta"><%= listing.address.presence || "住所未登録" %></p>
            <p class="pending-meta">更新日: <%= listing.source_updated_at&.to_date %></p>
          </div>
        <% end %>
      </div>
    </section>
  </aside>

  <section class="map-stage">
    <div id="listing-map" class="map-canvas" data-map-target="canvas"></div>
    <div class="map-overlay">
      <span class="map-count" data-map-target="count"></span>
    </div>
  </section>
</div>
