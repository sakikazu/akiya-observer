<% content_for :head do %>
  <link rel="stylesheet" href="https://unpkg.com/leaflet@1.9.4/dist/leaflet.css" integrity="sha256-p4NxAoJBhIIN+hmNHrzRCf9tD/miZyoHS5obTRR9BMY=" crossorigin="">
  <script src="https://unpkg.com/leaflet@1.9.4/dist/leaflet.js" integrity="sha256-20nQCchB9co0qIjJZRGuk2/Z9VM+kNiyxNV1lvTlZBo=" crossorigin=""></script>
  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
  <link href="https://fonts.googleapis.com/css2?family=Space+Grotesk:wght@500;700&family=Noto+Sans+JP:wght@400;600&display=swap" rel="stylesheet">
<% end %>

<div class="map-shell" data-controller="map" data-map-listings-value="<%= json_escape(@map_listings.to_json) %>" data-map-schools-value="<%= json_escape(@map_schools.to_json) %>" data-map-missing-value="<%= json_escape(@map_missing_municipalities.to_json) %>">
  <aside class="map-sidebar">
    <div class="map-hero">
      <p class="map-eyebrow">Akiya Observer</p>
      <h1>新着物件の分布を<br>地図で俯瞰する</h1>
      <p class="map-subtitle">
        住所精度と更新日を合わせて確認し、供給の偏りを一目で把握します。
      </p>
      <div class="map-controls">
        <label class="toggle">
          <input type="checkbox" data-action="map#toggleDisappeared">
          <span>掲載終了も表示</span>
        </label>
        <label class="toggle">
          <input type="checkbox" data-action="map#toggleRecentOnly">
          <span>新着（7日以内）のみ表示</span>
        </label>
        <label class="toggle">
          <input type="checkbox" data-action="map#toggleSchools" checked>
          <span>小学校を表示</span>
        </label>
        <label class="toggle">
          <input type="checkbox" data-action="map#toggleMissing" checked>
          <span>座標未取得の市区町村を表示</span>
        </label>
        <div class="legend">
          <span class="legend-item"><span class="dot dot-precise"></span>番地あり</span>
          <span class="legend-item"><span class="dot dot-area"></span>番地なし</span>
          <span class="legend-item"><span class="dot dot-gone"></span>掲載終了</span>
          <span class="legend-item"><span class="dot dot-school"></span>小学校</span>
          <span class="legend-item"><span class="dot dot-missing"></span>座標未取得</span>
        </div>
      </div>
    </div>

  </aside>

  <section class="map-stage">
    <div id="listing-map" class="map-canvas" data-map-target="canvas"></div>
    <div class="map-overlay">
      <span class="map-count" data-map-target="count"></span>
      <span class="map-mode" data-map-target="mode"></span>
    </div>
  </section>
</div>
